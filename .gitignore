# Public distribution allowlist. Runtime outreach belongs outside this repo.
/*
!/.gitignore
!/README.md
!/NOTE_FOR_A_FRIEND.md
!/CONTRIBUTING.md
!/outreach-ledger/
/outreach-ledger/*
!/outreach-ledger/SKILL.md
!/outreach-ledger/agents/
/outreach-ledger/agents/*
!/outreach-ledger/agents/openai.yaml
!/benchmarks/
/benchmarks/*
!/benchmarks/README.md
!/benchmarks/result-template.json
!/benchmarks/results/
/benchmarks/results/*
!/benchmarks/results/*.json
# Never admit common private/runtime JSON names as benchmark submissions.
**/.env*
**/config.json
**/profile.json
**/contacts.json
**/activity.json
**/state.json
**/credentials*.json
**/secrets*.json
